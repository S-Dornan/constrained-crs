# ==========================================
# UPTIME KUMA ENDPOINTS (Log Vault Observability)
# ==========================================
# Include everything before the "?" in the Uptime Kuma push URLs.
LOG_FILE=/var/log/experiment-telemetry.log
HEALTH_PUSH_URL=https://uptime.example.com/api/push/YOUR_HEALTH_KEY
STREAM_PUSH_URL=https://uptime.example.com/api/push/YOUR_STREAM_KEY

# ==========================================
# CLOUDFLARE ZERO TRUST AUTHENTICATION
# ==========================================
# Ensure the .access trailing element is included in the Client ID
CF_CLIENT_ID=your_client_id.access
CF_CLIENT_SECRET=your_client_secret

# ==========================================
# CRSBENCH UPSTREAM API (Cleanroom Fuzzer)
# ==========================================
# Injected dynamically into the Cleanroom fuzzer upon provisioning
CRSBENCH_LLM_UPSTREAM_BASE_URL=https://api.openai.com/v1
CRSBENCH_LLM_UPSTREAM_API_KEY=your_gemini_api_key