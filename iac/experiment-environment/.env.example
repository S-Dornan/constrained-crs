# ==========================================
# PROXMOX HYPERVISOR CONFIGURATION
# ==========================================
TEMPLATE_ID=9001 # Replace with the ID of your template here
STORAGE="local-lvm" # Replace with the storage pool name where your template is stored
VM1_SNIPPET_PATH="local:snippets/cloud-init-logging.yaml" # Replace with the path to your cloud-init snippet for VM1
VM2_SNIPPET_PATH="local:snippets/cloud-init-cleanroom.yaml" # Replace with the path to your cloud-init snippet for VM2
VM1_ID="301" # Replace with the ID of your VM here
VM2_ID="302" # Replace with the ID of your VM here
VM1_IP="172.16.255.20/24" # Replace with the IP address of your VM here
VM2_IP="172.16.255.21/24" # Replace with the IP address of your VM here
SERIAL_PORT="9001" # Replace with the serial port of your VM here. 9001 is the default for teletype however

# ==========================================
# UPTIME KUMA ENDPOINTS (Log Vault Observability)
# ==========================================
# Include everything before the "?" in the Uptime Kuma push URLs.
LOG_FILE=/var/log/experiment-telemetry.log # Replace with the path to your log file on your logging VM here
HEALTH_PUSH_URL=https://uptime.example.com/api/push/YOUR_HEALTH_KEY # Replace with the Uptime Kuma health push URL for your logging VM here
STREAM_PUSH_URL=https://uptime.example.com/api/push/YOUR_STREAM_KEY # Replace with the Uptime Kuma stream push URL for your logging VM here

# ==========================================
# CLOUDFLARE ZERO TRUST AUTHENTICATION
# ==========================================
# Ensure the .access trailing element is included in the Client ID
CF_CLIENT_ID=your_client_id.access # Replace with your Cloudflare Client ID
CF_CLIENT_SECRET=your_client_secret # Replace with your Cloudflare Client Secret

# ==========================================
# CRSBENCH UPSTREAM API (Cleanroom Fuzzer)
# ==========================================
# Injected dynamically into the Cleanroom fuzzer upon provisioning
CRSBENCH_LLM_UPSTREAM_BASE_URL=https://api.openai.com/v1 # Replace with the base URL of your upstream API here
CRSBENCH_LLM_UPSTREAM_API_KEY=your_api_key # Replace with your upstream API key here

# ==========================================
# RCLONE REMOTE STORAGE (Cloud Storage)
# ==========================================
# Format: <RemoteNameFromConfig>:<FolderPath>/
RCLONE_REMOTE_PATH="CloudStorage:path/to/your/remote/directory/" # Replace with the path to your remote directory on the cloud storage provider here